# STAGE 1
FROM node:14-alpine as builder
RUN mkdir -p /home/node/front/node_modules && chown -R node:node /home/node/front
WORKDIR /home/node/front
COPY Energiepad/energiepadui/package*.json ./
COPY Energiepad/energiepadui/yarn.lock ./
USER node
RUN npm install
COPY --chown=node:node ./Energiepad/energiepadui .
RUN ls -la

ARG REACT_APP_API_URL
ENV REACT_APP_API_URL=$REACT_APP_API_URL

RUN npm run build

EXPOSE 3000
CMD [ "node", "server.js" ]

