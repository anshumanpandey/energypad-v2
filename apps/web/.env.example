DATABASE_URL=postgresql://energiepad:local-only@127.0.0.1:55432/energiepad_v2
AUTH_URL=http://localhost:3100
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Leave empty for private .local/mail capture in development.
# Production requires a Resend key and a verified sender domain.
RESEND_API_KEY=
EMAIL_FROM=EnergiePad <hello@energiepad.local>

# Required in production: Open-Meteo key with Historical Weather API entitlement.
# Without a key, development uses the public endpoint for evaluation/prototyping only.
OPEN_METEO_API_KEY=

# AI answers: disabled until both values are set. Choose a model supporting Responses structured outputs.
OPENAI_API_KEY=
OPENAI_MODEL=
AI_DAILY_ATTEMPT_LIMIT=20

# Server-only JSON catalogue; leave empty until test-mode price mappings are approved.
# See docs/SPRINT_7_DESIGN.md. This does not enable checkout.
BILLING_PRICE_CATALOGUE=
