generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  ADMIN
  ANALYST
  SITE_MANAGER
  VIEWER
}

enum PlatformRole {
  USER
  PLATFORM_ADMIN
}

enum PlanKey {
  STARTER
  GROWTH
  PROFESSIONAL
  ENTERPRISE
}

model User {
  id            String       @id @default(uuid()) @db.Uuid
  name          String?
  email         String       @unique
  emailVerified DateTime?    @db.Timestamptz(3)
  image         String?
  platformRole  PlatformRole @default(USER)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)
  passwordCredential PasswordCredential?
  accounts      Account[]
  sessions      Session[]
  memberships   Membership[]
}

model PasswordCredential {
  userId String @id @db.Uuid
  passwordHash String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(3)
  @@unique([identifier, token])
}

model Plan {
  key          PlanKey @id
  name         String
  siteLimit    Int?
  entitlements Json
  organisations Organisation[]
}

model Organisation {
  legacyEnergyBatches LegacyEnergyBatch[]
  legacyEnergyRows LegacyEnergyRow[]
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  currency    String   @default("GBP") @db.Char(3)
  timezone    String   @default("Europe/London")
  planKey     PlanKey  @default(STARTER)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  plan        Plan     @relation(fields: [planKey], references: [key])
  memberships Membership[]
  invitations Invitation[]
  sites       Site[]
  auditEvents AuditEvent[]
  portfolios Portfolio[]
  imports ImportBatch[]
  legacyTariffBatches LegacyTariffBatch[]
  energyCatalog EnergyCatalogVersion[]
  emissionFactors EmissionFactorVersion[]
}

model Membership {
  opportunityWork OpportunityWorkVersion[]
  opportunities Opportunity[]
  id             String         @id @default(uuid()) @db.Uuid
  organisationId String         @db.Uuid
  userId         String         @db.Uuid
  role           MembershipRole
  revokedAt      DateTime?      @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  siteAssignments SiteAssignment[]
  @@unique([organisationId, userId])
  @@unique([id, organisationId])
  @@index([userId, revokedAt])
}

model Site {
 aiInteractions AIInteraction[]
 monthlyPlans MonthlyPlanVersion[]
 carbonWorkbookBatches CarbonWorkbookBatch[]
  events OperationalEvent[]
  eventImports EventImportBatch[]
  patterns OperatingPattern[]
  patternImports PatternImportBatch[]
  occupancy OccupancyObservation[]
  occupancyImports OccupancyImportBatch[]
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @db.Uuid
  code           String
  name           String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  assignments    SiteAssignment[]
  invitationSites InvitationSite[]
  portfolioId String? @db.Uuid
  portfolio Portfolio? @relation(fields: [portfolioId, organisationId], references: [id, organisationId])
  type String?
  address String?
  postCode String?
  town String?
  country String?
  region String?
  currency String? @db.Char(3)
  externalLegacyId String?
  archivedAt DateTime? @db.Timestamptz(3)
  attributes SiteAttributeHistory[]
  meters Meter[]
  carbonRuns CarbonRun[]
  consumption ConsumptionRecord[]
  weatherConfigurations WeatherConfiguration[]
  driverObservations DriverObservation[]
  operatingSchedules OperatingSchedule[]
  driverImports DriverImportBatch[]
  energyUses SiteEnergyUse[]
  @@unique([id, organisationId])
  @@unique([organisationId, code])
}

model SiteAssignment {
  organisationId String @db.Uuid
  membershipId   String @db.Uuid
  siteId         String @db.Uuid
  membership     Membership @relation(fields: [membershipId, organisationId], references: [id, organisationId], onDelete: Cascade)
  site           Site @relation(fields: [siteId, organisationId], references: [id, organisationId], onDelete: Cascade)
  @@id([membershipId, siteId])
  @@index([organisationId, siteId])
}

model Invitation {
  id             String         @id @default(uuid()) @db.Uuid
  organisationId String         @db.Uuid
  email          String
  role           MembershipRole
  tokenHash      String         @unique
  invitedBy      String         @db.Uuid
  expiresAt      DateTime       @db.Timestamptz(3)
  acceptedAt     DateTime?      @db.Timestamptz(3)
  revokedAt      DateTime?      @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  sites          InvitationSite[]
  @@unique([id, organisationId])
  @@index([organisationId, email])
}

model InvitationSite {
  organisationId String @db.Uuid
  invitationId   String @db.Uuid
  siteId         String @db.Uuid
  invitation     Invitation @relation(fields: [invitationId, organisationId], references: [id, organisationId], onDelete: Cascade)
  site           Site @relation(fields: [siteId, organisationId], references: [id, organisationId], onDelete: Cascade)
  @@id([invitationId, siteId])
}

model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @db.Uuid
  actorUserId    String   @db.Uuid
  action         String
  targetId       String
  correlationId  String   @db.Uuid
  metadata       Json
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  @@index([organisationId, createdAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int
  expiresAt DateTime @db.Timestamptz(3)
}

model Portfolio {
  id String @id @default(uuid()) @db.Uuid
  organisationId String @db.Uuid
  name String
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  organisation Organisation @relation(fields: [organisationId], references: [id])
  sites Site[]
  @@unique([id, organisationId])
  @@unique([organisationId, name])
}

model SiteAttributeHistory {
  id String @id @default(uuid()) @db.Uuid
  organisationId String @db.Uuid
  siteId String @db.Uuid
  effectiveFrom DateTime @db.Date
  population Decimal? @db.Decimal(14, 3)
  floorArea Decimal? @db.Decimal(14, 3)
  weeklyHours Decimal? @db.Decimal(7, 3)
  vatPercent Decimal? @db.Decimal(6, 3)
  authorId String @db.Uuid
  importBatchId String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  site Site @relation(fields: [siteId, organisationId], references: [id, organisationId])
  batch ImportBatch? @relation(fields: [importBatchId, organisationId], references: [id, organisationId])
  @@unique([siteId, effectiveFrom])
}

model Meter {
 carbonTargets CarbonTargetVersion[]
  baselines BaselineVersion[]
  id String @id @default(uuid()) @db.Uuid
  organisationId String @db.Uuid
  siteId String @db.Uuid
  code String
  name String
  fuel String
  unit String
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  site Site @relation(fields: [siteId, organisationId], references: [id, organisationId])
  consumption ConsumptionRecord[]
  conversions UnitConversionVersion[]
  energyImports EnergyImportBatch[]
  @@unique([id, siteId, organisationId])
  @@unique([siteId, code])
  @@unique([id, organisationId])
}

model ImportBatch {
  id String @id @default(uuid()) @db.Uuid
  organisationId String @db.Uuid
  fingerprint String
  createdBy String @db.Uuid
  status String @default("UPLOADED")
  sheets Json
  mapping Json?
  result Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  committedAt DateTime? @db.Timestamptz(3)
  organisation Organisation @relation(fields: [organisationId], references: [id])
  attributes SiteAttributeHistory[]
  @@unique([organisationId, fingerprint])
  @@unique([id, organisationId])
}

model ConsumptionRecord {
  sourceProvenance Json?
  revision Int @default(1)
  supersedesId String? @db.Uuid
  correctionReason String?
  id String @id @default(uuid()) @db.Uuid
  organisationId String @db.Uuid
  siteId String @db.Uuid
  meterId String @db.Uuid
  periodStart DateTime @db.Date
  periodEnd DateTime @db.Date
  sourceQuantity Decimal @db.Decimal(16, 3)
  sourceUnit String
  fuel String
  normalizedKwh Decimal @db.Decimal(19, 3)
  conversionFactor Decimal @db.Decimal(16, 6)
  conversionVersion String
  energyImportId String? @db.Uuid
  energyImport EnergyImportBatch? @relation(fields: [energyImportId, organisationId], references: [id, organisationId])
  conversionId String? @db.Uuid
  conversion UnitConversionVersion? @relation(fields: [conversionId, organisationId], references: [id, organisationId])
  estimated Boolean @default(false)
  netCost Decimal? @db.Decimal(16, 3)
  vatPercent Decimal? @db.Decimal(6, 3)
  vatCost Decimal? @db.Decimal(16, 3)
  grossCost Decimal? @db.Decimal(16, 3)
  currency String? @db.Char(3)
  endUse String
  energyUseId String? @db.Uuid
  energyUseSnapshot Json?
  energyUse SiteEnergyUse? @relation(fields: [energyUseId, organisationId, siteId], references: [id, organisationId, siteId])
  externalLegacyId String
  attributeSnapshot Json
  qualityFlags Json
  authorId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  site Site @relation(fields: [siteId, organisationId], references: [id, organisationId])
  meter Meter @relation(fields: [meterId, siteId, organisationId], references: [id, siteId, organisationId])
  previous ConsumptionRecord? @relation("ReadingRevisions", fields:[supersedesId,organisationId], references:[id,organisationId], onDelete:NoAction, onUpdate:NoAction)
  replacement ConsumptionRecord? @relation("ReadingRevisions")
  @@unique([id,organisationId])
  @@unique([supersedesId,organisationId])
  @@index([organisationId, siteId, periodStart])
}

model UnitConversionVersion {
  revision Int @default(1)
  supersedesId String? @db.Uuid
  correctionReason String?
  id String @id @default(uuid()) @db.Uuid
  organisationId String @db.Uuid
  siteId String @db.Uuid
  meterId String @db.Uuid
  sourceUnit String
  fuel String
  factor Decimal @db.Decimal(16, 6)
  validFrom DateTime @db.Date
  validUntil DateTime @db.Date
  source String
  authorId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  meter Meter @relation(fields: [meterId, siteId, organisationId], references: [id, siteId, organisationId])
  records ConsumptionRecord[]
  @@unique([id, organisationId])
  previous UnitConversionVersion? @relation("ConversionRevisions", fields:[supersedesId,organisationId], references:[id,organisationId], onDelete:NoAction, onUpdate:NoAction)
  replacement UnitConversionVersion? @relation("ConversionRevisions")
  @@unique([supersedesId,organisationId])
  @@index([organisationId, siteId])
}

model EnergyImportBatch {
  id String @id @default(uuid()) @db.Uuid
  organisationId String @db.Uuid
  siteId String @db.Uuid
  meterId String @db.Uuid
  fingerprint String
  status String @default("UPLOADED")
  sheets Json
  mapping Json?
  result Json?
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  committedAt DateTime? @db.Timestamptz(3)
  meter Meter @relation(fields: [meterId, siteId, organisationId], references: [id, siteId, organisationId])
  records ConsumptionRecord[]
  @@unique([id, organisationId])
  @@unique([meterId, fingerprint])
  @@index([organisationId, siteId])
}

model DriverObservation {
  id String @id @default(uuid()) @db.Uuid
  organisationId String @db.Uuid
  siteId String @db.Uuid
  month DateTime @db.Date
  driver String
  value Decimal @db.Decimal(14, 3)
  source String
  authorId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  importBatchId String? @db.Uuid
  site Site @relation(fields: [siteId, organisationId], references: [id, organisationId])
  batch DriverImportBatch? @relation(fields: [importBatchId, organisationId], references: [id, organisationId])
  @@index([organisationId, siteId])
  revision Int @default(1)
  supersedesId String? @db.Uuid
  correctionReason String?
  previous DriverObservation? @relation("ObservationRevisions", fields: [supersedesId, organisationId], references: [id, organisationId], onDelete: NoAction, onUpdate: NoAction)
  replacement DriverObservation? @relation("ObservationRevisions")
  @@unique([id, organisationId])
  @@unique([supersedesId, organisationId])
}

model OperatingSchedule {
  id String @id @default(uuid()) @db.Uuid
  organisationId String @db.Uuid
  siteId String @db.Uuid
  name String
  validFrom DateTime @db.Date
  validUntil DateTime @db.Date
  weeklyHours Decimal @db.Decimal(6, 3)
  source String
  authorId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  site Site @relation(fields: [siteId, organisationId], references: [id, organisationId])
  @@index([organisationId, siteId, validFrom])
  revision Int @default(1)
  supersedesId String? @db.Uuid
  correctionReason String?
  previous OperatingSchedule? @relation("ScheduleRevisions", fields: [supersedesId, organisationId], references: [id, organisationId], onDelete: NoAction, onUpdate: NoAction)
  replacement OperatingSchedule? @relation("ScheduleRevisions")
  @@unique([id, organisationId])
  @@unique([supersedesId, organisationId])
}

model DriverImportBatch {
  id String @id @default(uuid()) @db.Uuid
  organisationId String @db.Uuid
  siteId String @db.Uuid
  fingerprint String
  result Json
  status String
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  committedAt DateTime? @db.Timestamptz(3)
  site Site @relation(fields: [siteId, organisationId], references: [id, organisationId])
  observations DriverObservation[]
  @@unique([id, organisationId])
  @@unique([siteId, fingerprint])
}

model WeatherConfiguration {
  id String @id @default(uuid()) @db.Uuid
  organisationId String @db.Uuid
  siteId String @db.Uuid
  version Int
  latitude Decimal @db.Decimal(9,6)
  longitude Decimal @db.Decimal(9,6)
  timezone String
  heatingBase Decimal @db.Decimal(6,3)
  coolingBase Decimal @db.Decimal(6,3)
  source String
  authorId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  site Site @relation(fields:[siteId, organisationId], references:[id, organisationId])
  results WeatherYear[]
  jobs WeatherJob[]
  @@unique([siteId, version])
  @@unique([id, siteId, organisationId])
}

model WeatherYear {
  id String @id @default(uuid()) @db.Uuid
  organisationId String @db.Uuid
  siteId String @db.Uuid
  configurationId String @db.Uuid
  year Int
  methodology String
  provenance Json
  daily Json
  monthly Json
  inputHash String
  authorId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  configuration WeatherConfiguration @relation(fields:[configurationId,siteId,organisationId], references:[id,siteId,organisationId])
  @@unique([configurationId, year, methodology])
  @@index([organisationId, siteId, year])
}

model WeatherJob {
  id String @id @default(uuid()) @db.Uuid
  organisationId String @db.Uuid
  siteId String @db.Uuid
  configurationId String @db.Uuid
  year Int
  methodology String
  status String @default("QUEUED")
  attempts Int @default(0)
  totalAttempts Int @default(0)
  requestedBy String @db.Uuid
  correlationId String @db.Uuid
  availableAt DateTime @default(now()) @db.Timestamptz(3)
  leaseToken String? @db.Uuid
  leaseUntil DateTime? @db.Timestamptz(3)
  lastErrorCode String?
  lastError String?
  resultId String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)
  configuration WeatherConfiguration @relation(fields:[configurationId,siteId,organisationId], references:[id,siteId,organisationId])
  @@unique([configurationId, year, methodology])
  @@index([status, availableAt])
  @@index([organisationId, siteId, year])
}

model SiteEnergyUse {
  baselines BaselineVersion[]
  events OperationalEvent[]
  patterns OperatingPattern[]
  occupancy OccupancyObservation[]
  id String @id @default(uuid()) @db.Uuid
  organisationId String @db.Uuid
  siteId String @db.Uuid
  code String
  name String
  fuel String
  source String
  legacySource String @default("")
  fuelLegacyId String @default("")
  endUseLegacyId String @default("")
  associationLegacyId String @default("")
  associationLegacyTable String @default("")
  authorId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  site Site @relation(fields: [siteId, organisationId], references: [id, organisationId])
  tariffs TariffVersion[]
  @@unique([id, organisationId, siteId])
  @@unique([organisationId, siteId, code])
  fuelCatalogId String? @db.Uuid
  endUseCatalogId String? @db.Uuid
  fuelCatalog EnergyCatalogVersion? @relation("UseFuelCatalog", fields: [fuelCatalogId, organisationId], references: [id, organisationId])
  endUseCatalog EnergyCatalogVersion? @relation("UseEndCatalog", fields: [endUseCatalogId, organisationId], references: [id, organisationId])
  readings ConsumptionRecord[]
}

model TariffVersion {
  id String @id @default(uuid()) @db.Uuid
  organisationId String @db.Uuid
  siteId String @db.Uuid
  energyUseId String @db.Uuid
  name String
  validFrom DateTime @db.Date
  validUntil DateTime @db.Date
  currency String @db.Char(3)
  rateUnit String
  taxBasis String
  vatPercent Decimal @db.Decimal(6,3)
  timezone String
  source String
  legacySource String @default("")
  pricingLegacyId String @default("")
  bands Json
  revision Int @default(1)
  supersedesId String? @db.Uuid
  correctionReason String?
  authorId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  energyUse SiteEnergyUse @relation(fields: [energyUseId, organisationId, siteId], references: [id, organisationId, siteId])
  previous TariffVersion? @relation("TariffRevisions", fields: [supersedesId, organisationId], references: [id, organisationId], onDelete: NoAction, onUpdate: NoAction)
  replacement TariffVersion? @relation("TariffRevisions")
  @@unique([id, organisationId])
  @@unique([supersedesId, organisationId])
  @@index([organisationId, siteId, energyUseId])
}

model EnergyCatalogVersion {
  id String @id @default(uuid()) @db.Uuid
  organisationId String @db.Uuid
  kind String
  code String
  fuel String
  name String
  color String
  source String
  legacySource String @default("")
  legacyId String @default("")
  retired Boolean @default(false)
  revision Int @default(1)
  supersedesId String? @db.Uuid
  correctionReason String?
  authorId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  organisation Organisation @relation(fields: [organisationId], references: [id])
  previous EnergyCatalogVersion? @relation("CatalogRevisions", fields: [supersedesId, organisationId], references: [id, organisationId], onDelete: NoAction, onUpdate: NoAction)
  replacement EnergyCatalogVersion? @relation("CatalogRevisions")
  fuelUses SiteEnergyUse[] @relation("UseFuelCatalog")
  endUses SiteEnergyUse[] @relation("UseEndCatalog")
  @@unique([id, organisationId])
  @@unique([supersedesId, organisationId])
  @@index([organisationId, kind, code])
}

model LegacyTariffBatch {
  id String @id @default(uuid()) @db.Uuid
  organisationId String @db.Uuid
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  adapter String
  source String
  inputHash String
  authorId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  receipt Json
  @@unique([organisationId, adapter, inputHash])
}

model OccupancyObservation {
 id String @id @default(uuid()) @db.Uuid
 organisationId String @db.Uuid
 siteId String @db.Uuid
 energyUseId String @db.Uuid
 validFrom DateTime @db.Date
 validUntil DateTime @db.Date
 regularCount Int?
 irregularCount Int?
 source String
 legacySource String @default("")
 legacyId String @default("")
 authorId String @db.Uuid
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 revision Int @default(1)
 supersedesId String? @db.Uuid
 correctionReason String?
 importBatchId String? @db.Uuid
 site Site @relation(fields: [siteId, organisationId], references: [id, organisationId])
 energyUse SiteEnergyUse @relation(fields: [energyUseId, organisationId, siteId], references: [id, organisationId, siteId])
 batch OccupancyImportBatch? @relation(fields: [importBatchId, organisationId, siteId], references: [id, organisationId, siteId])
 previous OccupancyObservation? @relation("OccupancyRevisions", fields: [supersedesId, organisationId], references: [id, organisationId], onDelete: NoAction, onUpdate: NoAction)
 replacement OccupancyObservation? @relation("OccupancyRevisions")
 @@unique([id, organisationId])
 @@unique([supersedesId, organisationId])
 @@index([organisationId, siteId, energyUseId])
}
model OccupancyImportBatch {
 id String @id @default(uuid()) @db.Uuid
 organisationId String @db.Uuid
 siteId String @db.Uuid
 fingerprint String
 result Json
 status String
 createdBy String @db.Uuid
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 committedAt DateTime? @db.Timestamptz(3)
 site Site @relation(fields: [siteId, organisationId], references: [id, organisationId])
 observations OccupancyObservation[]
 @@unique([id, organisationId, siteId])
 @@unique([siteId, fingerprint])
}

model OperatingPattern {
 id String @id @default(uuid()) @db.Uuid
 organisationId String @db.Uuid
 siteId String @db.Uuid
 energyUseId String @db.Uuid
 validFrom DateTime @db.Date
 validUntil DateTime @db.Date
 daysOnYear Int?
 temperature Decimal? @db.Decimal(6,3)
 temperatureUnit String
 temperatureContext String
 source String
 legacySource String @default("")
 legacyId String @default("")
 authorId String @db.Uuid
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 revision Int @default(1)
 supersedesId String? @db.Uuid
 correctionReason String?
 importBatchId String? @db.Uuid
 site Site @relation(fields: [siteId, organisationId], references: [id, organisationId])
 energyUse SiteEnergyUse @relation(fields: [energyUseId, organisationId, siteId], references: [id, organisationId, siteId])
 batch PatternImportBatch? @relation(fields: [importBatchId, organisationId, siteId], references: [id, organisationId, siteId])
 previous OperatingPattern? @relation("PatternRevisions", fields: [supersedesId, organisationId], references: [id, organisationId], onDelete: NoAction, onUpdate: NoAction)
 replacement OperatingPattern? @relation("PatternRevisions")
 @@unique([id, organisationId])
 @@unique([supersedesId, organisationId])
 @@index([organisationId, siteId, energyUseId])
}
model PatternImportBatch {
 id String @id @default(uuid()) @db.Uuid
 organisationId String @db.Uuid
 siteId String @db.Uuid
 fingerprint String
 result Json
 status String
 createdBy String @db.Uuid
