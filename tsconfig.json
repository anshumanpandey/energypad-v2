{
  "compilerOptions": {
    "target": "es5",
    "module": "commonjs",
    "rootDir": "./src",
    "paths": {
      "@lib": [
        "./src/lib"
      ],
      "@middleware": ["./src/middleware"],
      "@routes/v1": [
        "./src/routes/v1"
      ],
      "@openApi": [
        "./src/openApi"
      ]
    },
    "resolveJsonModule": true,
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "strict": true,
    "skipLibCheck": true,
    "inlineSourceMap": true
  },
  "exclude": [
    "test/**/*.ts",
    "src/scripts/**/*.ts"
  ]
}
