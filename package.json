{
  "name": "fuel-system",
  "version": "0.0.1",
  "main": "index.js",
  "license": "MIT",
  "engines": {
    "npm": "please-use-yarn"
  },
  "scripts": {
    "predev": "npm run generate:definitions && NODE_ENV=development npm run build",
    "dev": "NODE_ENV=development ts-node ./src/index.ts --project ./tsconfig.json",
    "prestart": "npm run generate:definitions && NODE_ENV=development npm run build",
    "start": "node dist/index.js",
    "build": "tsc --project ./tsconfig.json",
    "generate:definitions": "NODE_ENV=development npm run generate:types && NODE_ENV=development npm run generate:schema",
    "generate:types": "tsc --project ./types-tsconfig.json && ts-node ./src/scripts/GenerateTypes.ts",
    "generate:schema": "tsc --project ./types-tsconfig.json && ts-node --project ./types-tsconfig.json ./src/scripts/GenerateSchema.ts",
    "lint": "eslint src/**/*.ts",
    "format": "eslint src/**/*.ts --fix",
    "pretest": "rm -f testdb.sqlite3 && npm run predev",
    "test": "NODE_ENV=test jest --runInBand --detectOpenHandles",
    "jest": "jest --runInBand --detectOpenHandles",
    "generate:migration": "NODE_ENV=development knex migrate:make --knexfile ./src/lib/db/knexfile.ts",
    "generate:seed:test": "NODE_ENV=test knex seed:make --knexfile ./src/lib/db/knexfile.ts",
    "generate:seed:dev": "NODE_ENV=development knex seed:make --knexfile ./src/lib/db/knexfile.ts",
    "migration:execute": "knex seed:run --knexfile ./src/lib/db/knexfile.ts",
    "seed:execute": "knex migrate:latest --knexfile ./src/lib/db/knexfile.ts"
  },
  "devDependencies": {
    "@openapi-contrib/openapi-schema-to-json-schema": "^3.1.1",
    "@stoplight/json-ref-resolver": "^3.1.3",
    "@types/bcrypt": "^5.0.0",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.13",
    "@types/express-jwt": "^6.0.2",
    "@types/express-request-id": "^1.4.3",
    "@types/jest": "^27.0.2",
    "@types/jest-json-schema": "^2.1.3",
    "@types/jsonwebtoken": "^8.5.5",
    "@types/multer": "^1.4.7",
    "@types/node": "^16.11.6",
    "@types/supertest": "^2.0.11",
    "@typescript-eslint/eslint-plugin": "^5.3.0",
    "@typescript-eslint/parser": "^5.3.0",
    "ajv": "^8.8.0",
    "eslint": "^8.1.0",
    "jest": "^27.3.1",
    "openapi-types": "^9.3.1",
    "prettier": "^2.4.1",
    "sqlite3": "^5.0.2",
    "supertest": "^6.1.6",
    "ts-jest": "^27.0.7",
    "ts-node": "^10.4.0",
    "typescript": "^4.4.4"
  },
  "dependencies": {
    "@wesleytodd/openapi": "^0.1.0",
    "ajv-keywords": "3.5.2",
    "bcrypt": "^5.0.1",
    "cors": "^2.8.5",
    "decimal.js": "^10.3.1",
    "dotenv": "^10.0.0",
    "envalid": "^7.2.2",
    "exceljs": "^4.3.0",
    "express": "^4.17.1",
    "express-json-validator-middleware": "^2.2.1",
    "express-jwt": "^6.1.0",
    "express-request-id": "^1.4.1",
    "helmet": "^4.6.0",
    "husky": "^7.0.4",
    "jest-json-schema": "^5.0.0",
    "jsonwebtoken": "^8.5.1",
    "knex": "^0.95.14",
    "module-alias": "^2.2.2",
    "multer": "^1.4.3",
    "openapi-typescript": "^4.4.0",
    "pg": "^8.7.1",
    "pino": "^7.1.0"
  },
  "_moduleAliases": {
    "@lib": "dist/lib",
    "@openApi": "dist/openApi",
    "@routes/v1": "dist/routes/v1",
    "@middleware": "dist/middleware",
    "@types": "dist/types",
    "@controllers": "dist/controllers",
    "@services": "./dist/services",
    "@utils": "./dist/utils"
  },
  "husky": {
    "hooks": {
      "pre-commit": "yarn lint"
    }
  }
}
